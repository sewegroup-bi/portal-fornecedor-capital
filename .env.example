# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Supabase.
# (Project Settings -> API)

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon public key — pode ir para o navegador (RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SECRETA. Só usada em rotinas de importação no servidor.
# Nunca exponha no navegador nem commite no Git.
SUPABASE_SERVICE_ROLE_KEY=
